# Copy this file to .env.local and fill in what you have.
# .env.local is gitignored — never commit real keys. This repo is public.
#
# Everything is optional: the dashboard runs with none of these set, and each
# tab tells you what it needs. Restart the dev server after editing.

# Where the app is reachable. Must match your Strava callback domain.
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Strava — https://www.strava.com/settings/api
# Create an app, set "Authorization Callback Domain" to: localhost
# ---------------------------------------------------------------------------
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Hevy — https://hevy.com/settings?developer   (requires Hevy Pro)
# Without Pro, leave this blank and import a CSV export on the Fitness tab.
# ---------------------------------------------------------------------------
HEVY_API_KEY=

# ---------------------------------------------------------------------------
# Kalorické tabulky — your normal login.
# UNOFFICIAL: there is no public API, so this drives the website's internal
# endpoints and may break without warning.
# ---------------------------------------------------------------------------
KT_EMAIL=
KT_PASSWORD=

# ---------------------------------------------------------------------------
# Trading 212 — app → Settings → API (Beta) → Generate API key
# Invest/ISA accounts only (not CFD). Read scopes are all this needs.
# T212_ENV: "live" (default) or "demo" for the practice account.
# ---------------------------------------------------------------------------
T212_API_KEY=
T212_ENV=live

# ---------------------------------------------------------------------------
# AI coach — https://console.anthropic.com/settings/keys
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
